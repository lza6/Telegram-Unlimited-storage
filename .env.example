# =============================================================================
# Telegram Drive — 双模式配置（机器人优先 / 应用账号可选）
# =============================================================================
#
# 你只有「1 个 Bot + 1 个频道」时，填下面【机器人模式】三节即可跑通，无需 Session。
# 以后若要更大单文件/更高吞吐，再补【应用模式】凭据并在控制台切换模式。
#
# 部署后：docker compose up -d --build  或  start.bat
# 控制台：http://服务器IP:1334/dashboard.html
# =============================================================================

# --- 传输模式 ---
# bot   = 仅机器人（推荐：有 Bot Token 就用这个）
# user  = 用户 MTProto（需 API_ID/HASH + Web 登录生成 session）
# auto  = 有 TG_BOT_TOKEN 则 bot，否则 user（默认）
TELEGRAM_TRANSPORT_MODE=bot

# === 【机器人模式】必填（你当前场景）===
# @BotFather 创建机器人
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：多 Bot 轮询上传（逗号分隔），分摊 Bot API 限流；下载按 bot_pool_index 路由
# TG_BOT_TOKENS=123456789:AAyyyy...,987654321:BBzzzz...
# 私有存储频道 ID（形如 -100xxxxxxxxxx；机器人必须是频道管理员）
TG_STORAGE_CHANNEL_ID=-1001234567890
# 可选：本地 Bot API Server 时可改（香港服务器裸连一般留空）
# CUSTOM_BOT_API_URL=https://api.telegram.org
# 两次 Bot 上传间隔毫秒，防 FloodWait（默认 3500）
# BOT_RATE_LIMIT_MS=3500

# === 【应用模式】可选（以后扩容 / 大文件主通道时再填）===
# 从 https://my.telegram.org → API development 获取
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your_api_hash_here
# 填好后 Web「Telegram 登录」完成 session，或挂载 data/telegram.session

# === Web 管理 ===
ACCESS_PWD=change-me-strong-password
# 管理台登录失败锁定（IP）
ACCESS_LOCKOUT_MAX=8
ACCESS_LOCKOUT_SECS=300
API_KEY=generate-a-long-random-hex-key

# === 服务 ===
PORT=1334
BIND_HOST=0.0.0.0
DATA_DIR=./data
BASE_URL=http://localhost:1334

# 本地开发叠加 dev compose；生产香港服务器建议仅：
# COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

# CORS（逗号分隔；留空=禁止跨域）
# CORS_ORIGINS=https://admin.example.com

RATE_LIMIT_RPM=120
RATE_LIMIT_API_RPM=300

# 香港服务器无需代理；仅受限网络时启用
# PROXY_SOCKS5=socks5://127.0.0.1:1080

# 分片上传（tg-disk 兼容；Bot 模式单分片仍建议 ≤10MB）
# 服务端 UploadGate 与下列两项对齐：限制同时打 Telegram 的上传数；
# 500 客户端可同时连入，超出槽位返回 503，浏览器自动退避重试。
DOWNLOAD_THREADS=8
CHUNK_SIZE_MB=10
CHUNK_CONCURRENT=4
FILES_CONCURRENT=2

# 列表元数据缓存（SQLite WAL，与 shares.db 同库；单实例 7×24 推荐开启）
# 多 API 实例水平扩展时请 METADATA_CACHE_ENABLED=false 并改用共享存储方案（见 docs/planning/元数据缓存与企业部署.md）
METADATA_CACHE_ENABLED=true
METADATA_CACHE_TTL_SECS=300

# 下载安全（企业默认：HMAC 预签名 + 租户归属，禁止裸 file_id）
# PUBLIC_FILE_ID_DOWNLOAD=false  → 无法通过 /d?file_id=123 猜别人文件
# DOWNLOAD_SIGNING_SECRET        → ≥32 字符，上传返回 /d/signed?...&sig=（不落库，纯 URL 签名）
# UPLOAD_LINK_TTL_SECS=0           → 默认永久预签名直链（exp=0）；设 3600 等可限时
# 撤销永久链：轮换 DOWNLOAD_SIGNING_SECRET 或删除 file_assets 行
PUBLIC_FILE_ID_DOWNLOAD=false
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters-secret
UPLOAD_LINK_TTL_SECS=0
MULTI_TENANT_ENABLED=true
UPLOAD_SHARE_TTL_HOURS=0
# 多租户 API Key：复制 data/tenants.json.example → data/tenants.json（仅首次导入）

# WebDAV 企业接入（rclone / WinSCP；默认关闭）
WEBDAV_ENABLED=false
WEBDAV_PREFIX=/webdav

# Prometheus 文本指标 GET /metrics
METRICS_ENABLED=true

# 上传队列后端：memory（单进程）| redis（多副本共享槽位，需 REDIS_URL）
UPLOAD_QUEUE_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0
# 多副本示例：UPLOAD_QUEUE_BACKEND=redis + 同一 REDIS_URL + 相同 CHUNK_CONCURRENT/FILES_CONCURRENT

# 7×24 后台维护：过期分享 / 僵死分片 / 元数据缓存清理（秒，默认 3600）
# MAINTENANCE_INTERVAL_SECS=3600

# Bot 模式保活：定期 getMe 探测（小时，0=关闭，默认 24，对标 tgDrive）
# BOT_KEEPALIVE_HOURS=24

# RUST_LOG=info,actix_web=info
# LOG_FORMAT=json
