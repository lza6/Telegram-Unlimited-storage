# =============================================================================
# Telegram Drive — 生产 / 高并发 环境变量（配合 docker-compose.prod.yml）
# =============================================================================
# 复制：copy .env.prod.example .env
# 启动：COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml docker compose up -d --build
# =============================================================================

TELEGRAM_TRANSPORT_MODE=bot
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_STORAGE_CHANNEL_ID=-1001234567890

# 多 Bot 分摊 FloodWait（推荐 ≥3 个 Bot 再追求高并发）
# TG_BOT_TOKENS=token2,token3,token4
# BOT_RATE_LIMIT_MS=2800

ACCESS_PWD=change-me-strong-password
API_KEY=generate-a-long-random-hex-key
PORT=1334
BIND_HOST=0.0.0.0
DATA_DIR=./data
BASE_URL=https://your-domain.example.com

# 生产只用 release compose，不要叠加 dev
COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml

# --- 500 客户端同时连接 vs 实际上传吞吐 ---
# 500 个 HTTP 连接可以同时建立；真正打 Telegram 的上传数由 UploadGate 限制。
# 超出槽位返回 503 + Retry-After，浏览器/客户端应退避重试（upload-core.js 已实现）。
CHUNK_SIZE_MB=10
CHUNK_CONCURRENT=8
FILES_CONCURRENT=4
DOWNLOAD_THREADS=8

RATE_LIMIT_RPM=600
RATE_LIMIT_API_RPM=1200

UPLOAD_QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# 多 API 副本时关闭进程内元数据缓存，或改用共享 DB（当前为 SQLite 单文件）
METADATA_CACHE_ENABLED=false

PUBLIC_FILE_ID_DOWNLOAD=false
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters-secret
MULTI_TENANT_ENABLED=true
METRICS_ENABLED=true

# 扩容第二通道：大文件下载不受 20MB 限制
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_TRANSPORT_MODE=auto

# RUST_LOG=info
# LOG_FORMAT=json
