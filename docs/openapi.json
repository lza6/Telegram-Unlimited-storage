{
  "openapi": "3.0.3",
  "info": {
    "title": "Telegram Drive API",
    "description": "HTTP API for Telegram-backed object storage. Headless (Docker) exposes the full surface on one port (1334): legacy /upload, /metrics, WebDAV, static Web UI, and /d/* share downloads. Desktop optional REST API (127.0.0.1:8550) is a subset — see docs/DESKTOP-API.md. Authenticate with X-API-Key or X-Access-Pwd (Web admin / desktop local access password).",
    "version": "3.0.0-beta"
  },
  "servers": [{ "url": "/", "description": "Current host" }],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "AccessPwdAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Pwd",
        "description": "Web admin console password (ACCESS_PWD)"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "version", "telegram_connected", "uptime_secs", "build", "ready"],
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "version": { "type": "string", "example": "2.0.0" },
          "telegram_connected": { "type": "boolean" },
          "uptime_secs": { "type": "integer", "format": "int64" },
          "build": { "type": "string" },
          "ready": { "type": "boolean", "description": "True when Telegram session is connected and uploads/downloads can proceed" },
          "transport_mode": { "type": "string" },
          "bot_configured": { "type": "boolean" },
          "user_configured": { "type": "boolean" },
          "upload_queue": {
            "type": "object",
            "properties": {
              "chunk_slots_total": { "type": "integer" },
              "chunk_slots_available": { "type": "integer" },
              "file_slots_total": { "type": "integer" },
              "file_slots_available": { "type": "integer" }
            }
          },
          "metadata_cache_enabled": { "type": "boolean" },
          "presigned_download_enabled": { "type": "boolean" },
          "multi_tenant_enabled": { "type": "boolean" },
          "public_file_id_download": { "type": "boolean" },
          "upload_share_ttl_hours": { "type": "integer" }
        }
      },
      "FileItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "folder_id": { "type": "integer", "format": "int64", "nullable": true },
          "name": { "type": "string" },
          "size": { "type": "integer", "format": "int64" },
          "mime_type": { "type": "string", "nullable": true },
          "created_at": { "type": "string" }
        }
      },
      "FolderItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "LegacyUpload": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "file_id": { "type": "string", "description": "Telegram message id as string" },
          "download_url": { "type": "string", "description": "Public GET /d link (no API key)" }
        }
      },
      "ApiUploadResult": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "Telegram message id" },
          "file_id": { "type": "string" },
          "folder_id": { "type": "integer", "format": "int64", "nullable": true },
          "name": { "type": "string" },
          "filename": { "type": "string" },
          "share_id": { "type": "string", "description": "Opaque share token (empty when presigned)" },
          "expires_at": { "type": "integer", "nullable": true, "description": "Unix expiry; null = permanent presigned" },
          "download_url": { "type": "string", "description": "GET /d/signed?... (HMAC) or /d/{token}" },
          "api_download_url": { "type": "string", "description": "GET /api/v1/files/{id}/download with X-API-Key" },
          "owner_id": { "type": "string", "description": "Asset owner tenant:… or system:web" },
          "link_kind": { "type": "string", "enum": ["presigned", "share", "legacy"] }
        }
      },
      "SettingsResponse": {
        "type": "object",
        "properties": {
          "share_domain": { "type": "string", "description": "Override host for share links (ui_settings.json)" },
          "env_base_url": { "type": "string", "description": "BASE_URL from environment" },
          "effective_base_url": { "type": "string", "description": "Resolved API base from request or config" },
          "effective_share_base_url": { "type": "string", "description": "Stream/download base (desktop 14201 when configured)" },
          "effective_share_link_base": {
            "type": "string",
            "description": "Canonical base for /d/* links: Headless same as API host; desktop REST uses stream port"
          },
          "chunk_size_mb": { "type": "integer" },
          "chunk_concurrent": { "type": "integer" },
          "files_concurrent": { "type": "integer" },
          "download_threads": { "type": "integer" },
          "stream_port": { "type": "integer" },
          "max_upload_size_mb": { "type": "integer" }
        }
      },
      "SettingsUpdateResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "share_domain": { "type": "string" },
          "effective_base_url": { "type": "string" },
          "effective_share_base_url": { "type": "string" },
          "effective_share_link_base": { "type": "string" }
        }
      },
      "ProxyConfigPublic": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "proxy_type": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "username": { "type": "string" },
          "password_set": { "type": "boolean" }
        }
      },
      "NetworkResponse": {
        "type": "object",
        "properties": {
          "proxy": { "$ref": "#/components/schemas/ProxyConfigPublic" },
          "vpn": { "type": "object", "description": "VPN optimizer flags (redacted secrets)" }
        }
      },
      "BulkResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "count": { "type": "integer", "description": "Affected file count" },
          "succeeded_ids": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Message IDs successfully processed in this batch (Bot partial delete returns subset)"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/api/v1/transport": {
      "get": {
        "tags": ["System"],
        "summary": "Current Telegram transport mode (bot or user)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Transport info JSON" } }
      }
    },
    "/api/v1/transport/mode": {
      "post": {
        "tags": ["System"],
        "summary": "Switch transport mode at runtime",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "mode": { "type": "string", "enum": ["bot", "user"] } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Mode updated" } }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": ["System"],
        "summary": "Web admin settings (share domain, chunk config)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": {
          "200": {
            "description": "Settings JSON",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SettingsResponse" } }
            }
          }
        }
      },
      "put": {
        "tags": ["System"],
        "summary": "Update share domain override",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "share_domain": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SettingsUpdateResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/network": {
      "get": {
        "tags": ["System"],
        "summary": "Network/proxy/VPN optimizer config (redacted)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": {
          "200": {
            "description": "Network config",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/NetworkResponse" } }
            }
          }
        }
      },
      "put": {
        "tags": ["System"],
        "summary": "Update network_settings.json at runtime",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "proxy": {
                    "type": "object",
                    "properties": {
                      "enabled": { "type": "boolean" },
                      "proxy_type": { "type": "string" },
                      "host": { "type": "string" },
                      "port": { "type": "integer" },
                      "username": { "type": "string" },
                      "password": { "type": "string", "description": "Omit or empty to keep existing" }
                    }
                  },
                  "vpn": {
                    "type": "object",
                    "properties": { "enabled": { "type": "boolean" } }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/NetworkResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "tags": ["Auth"],
        "summary": "Telegram session status",
        "responses": { "200": { "description": "connected flag" } }
      }
    },
    "/api/v1/auth/phone/request": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request login code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": { "phone": { "type": "string", "example": "+8613800138000" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Code sent" } }
      }
    },
    "/api/v1/auth/phone/sign-in": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in with SMS code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Logged in" } }
      }
    },
    "/api/v1/auth/phone/password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign in with 2FA password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": { "password": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Logged in" } }
      }
    },
    "/api/v1/auth/qr/start": {
      "post": {
        "tags": ["Auth"],
        "summary": "Start QR login (returns tg:// URL)",
        "responses": { "200": { "description": "QR URL or already authorized" } }
      }
    },
    "/api/v1/auth/qr/poll": {
      "get": {
        "tags": ["Auth"],
        "summary": "Poll QR login status",
        "responses": { "200": { "description": "connected / waiting" } }
      }
    },
    "/api/v1/folders": {
      "get": {
        "tags": ["Folders"],
        "summary": "List storage folders ([TD] channels)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/FolderItem" } }
              }
            }
          }
        }
      }
    },
    "/api/v1/files": {
      "get": {
        "tags": ["Files"],
        "summary": "List files",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "folder_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "File list" } }
      },
      "post": {
        "tags": ["Files"],
        "summary": "Upload file (multipart, API Key)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "folder_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded file metadata with direct download links",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiUploadResult" }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/{message_id}": {
      "get": {
        "tags": ["Files"],
        "summary": "File metadata",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "message_id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "folder_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileItem" } } } } }
      }
    },
    "/api/v1/files/{message_id}/download": {
      "get": {
        "tags": ["Files"],
        "summary": "Download file (supports Range)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "message_id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "folder_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Binary stream" } }
      }
    },
    "/api/v1/files/search": {
      "get": {
        "tags": ["Files"],
        "summary": "Search files by name",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          {
            "name": "folder_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Limit search to folder scope (Bot asset index)"
          }
        ],
        "responses": { "200": { "description": "Matches" } }
      }
    },
    "/api/v1/files/bulk": {
      "post": {
        "tags": ["Files"],
        "summary": "Bulk delete or move",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action", "file_ids"],
                "properties": {
                  "action": { "type": "string", "enum": ["delete", "move"] },
                  "file_ids": { "type": "array", "items": { "type": "integer" } },
                  "folder_id": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Source folder for User-mode delete/move (omit = Saved Messages)"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "folder_id": { "type": "integer", "nullable": true, "description": "Target folder for move" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk result",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BulkResponse" } }
            }
          }
        }
      }
    },
    "/api/v1/files/rebuild-index": {
      "post": {
        "tags": ["Files"],
        "summary": "Rebuild User-mode file_assets index (full scan)",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "folder_ids": {
                    "type": "array",
                    "items": { "type": "integer", "nullable": true },
                    "description": "Folder IDs to scan; null element = Saved Messages. Empty = Saved Messages only."
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Rebuild result with folders_scanned and files_indexed" } }
      }
    },
    "/api/v1/shares": {
      "get": {
        "tags": ["Shares"],
        "summary": "List share links",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "responses": { "200": { "description": "Share list" } }
      },
      "post": {
        "tags": ["Shares"],
        "summary": "Create share link",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message_id", "file_name", "file_size"],
                "properties": {
                  "folder_id": { "type": "integer", "nullable": true },
                  "message_id": { "type": "integer" },
                  "file_name": { "type": "string" },
                  "file_size": { "type": "integer" },
                  "password": { "type": "string" },
                  "expiry_hours": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Share created" } }
      }
    },
    "/api/v1/shares/{id}": {
      "delete": {
        "tags": ["Shares"],
        "summary": "Revoke share link",
        "security": [{ "AccessPwdAuth": [] }, { "ApiKeyAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Revoked" } }
      }
    },
    "/config": {
      "get": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Upload/download tuning",
        "responses": { "200": { "description": "Config JSON" } }
      }
    },
    "/verify": {
      "post": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Verify ACCESS_PWD",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/upload": {
      "post": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Upload file (ACCESS_PWD)",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "pwd": { "type": "string" },
                  "file": { "type": "string", "format": "binary" },
                  "folder_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyUpload" } } }
          }
        }
      }
    },
    "/upload_status": {
      "get": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Chunk upload progress",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Progress token expiry (unix seconds); use with token from POST /upload_progress_token"
          },
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "HMAC progress token (preferred over pwd in URL)"
          },
          {
            "name": "pwd",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Legacy access password (avoid in logs; use token instead)"
          }
        ],
        "responses": {
          "200": { "description": "Status JSON" },
          "401": { "description": "missing or invalid auth" },
          "404": { "description": "session not found" }
        }
      }
    },
    "/upload_progress_token": {
      "post": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Issue short-lived upload progress token",
        "description": "Requires X-Access-Pwd or X-API-Key. Token valid 5 minutes for SSE/WS/status polling without pwd in URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["session_id"],
                "properties": {
                  "session_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_id": { "type": "string" },
                    "token": { "type": "string" },
                    "expires_at": { "type": "integer", "format": "int64" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/upload_events": {
      "get": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Upload progress (SSE)",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "pwd",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "text/event-stream JSON lines" },
          "400": { "description": "missing session_id" },
          "401": { "description": "missing or invalid auth" }
        }
      }
    },
    "/upload_ws": {
      "get": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Upload progress (WebSocket)",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "pwd",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "101": { "description": "WebSocket upgrade" },
          "400": { "description": "missing session_id" }
        }
      }
    },
    "/upload_chunk": {
      "post": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Upload one chunk (ACCESS_PWD)",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "pwd": { "type": "string" },
                  "chunk": { "type": "string", "format": "binary" },
                  "chunk_index": { "type": "string" },
                  "total_chunks": { "type": "string" },
                  "filename": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "file_id": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/merge_chunks": {
      "post": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Merge uploaded chunks into fileAll.txt manifest",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "pwd": { "type": "string" },
                  "filename": { "type": "string" },
                  "chunk_ids": { "type": "string", "description": "JSON array of message ids" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LegacyUpload" } } }
          }
        }
      }
    },
    "/d": {
      "get": {
        "tags": ["Legacy (tg-disk compatible)"],
        "summary": "Download by Telegram message id (file_id)",
        "parameters": [
          { "name": "file_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "filename", "in": "query", "schema": { "type": "string" } },
          { "name": "folder_id", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Binary stream" }, "403": { "description": "Blocked when PUBLIC_FILE_ID_DOWNLOAD=false or multi-tenant" } }
      }
    },
    "/d/signed": {
      "get": {
        "tags": ["Downloads"],
        "summary": "HMAC presigned download (exp=0 means no expiry)",
        "parameters": [
          { "name": "file_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "folder_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "owner", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "exp", "in": "query", "required": true, "schema": { "type": "integer", "description": "Unix expiry; 0 = never expires" } },
          { "name": "sig", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Binary stream" },
          "403": { "description": "Bad signature or owner mismatch" },
          "410": { "description": "Expired (when exp > 0)" }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["System"],
        "summary": "Prometheus metrics (when METRICS_ENABLED=true)",
        "responses": {
          "200": { "description": "text/plain metrics" },
          "404": { "description": "Metrics disabled" }
        }
      }
    },
    "/d/{token}": {
      "get": {
        "tags": ["Shares"],
        "summary": "Download shared file by token",
        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Binary stream or password prompt" } }
      }
    },
    "/d/{token}/verify": {
      "post": {
        "tags": ["Shares"],
        "summary": "Verify share password",
        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "password": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Access granted" } }
      }
    },
    "/stream/{folder_id}/{message_id}": {
      "get": {
        "tags": ["Media"],
        "summary": "Stream media (token query param)",
        "parameters": [
          { "name": "folder_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "message_id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "token", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Media stream" } }
      }
    }
  }
}
